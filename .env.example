# Forge local configuration
# Copy to .env only if you want environment-file based configuration.
# Do not put real API keys, passwords, tokens, or private URLs in this file.

FORGE_LLM_BASE_URL=http://127.0.0.1:5000/v1
FORGE_LLM_MODEL=local
FORGE_LLM_API_KEY=local

# Optional embedding model path.
# FORGE_EMBED_MODEL=/home/YOUR_USER/models/Qwen3-Embedding-4B

FORGE_COLLECTION_PREFIX=forge_knowledge
FORGE_RETRIEVAL_K=8
FORGE_MAX_CONTEXT_CHARS=12000
FORGE_MAX_HISTORY_CHARS=12000
FORGE_CHUNK_SIZE=1600
FORGE_CHUNK_OVERLAP=280
FORGE_MIN_SIMILARITY=0.35
FORGE_EMBED_BATCH_SIZE=8
FORGE_RRF_K=60
FORGE_MMR_LAMBDA=0.7
