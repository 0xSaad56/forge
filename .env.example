# Copy to .env for local overrides (.env is gitignored)

FORGE_LLM_BASE_URL=http://127.0.0.1:5000/v1
FORGE_LLM_MODEL=local
FORGE_LLM_API_KEY=local

# Set to 1 only if you intentionally send data to a non-loopback model API
# FORGE_ALLOW_REMOTE_LLM=0

FORGE_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B-Q
FORGE_EMBED_CACHE=~/models/forge-embedding
FORGE_INGEST_EMBED_DEVICE=cpu
FORGE_INGEST_EMBED_BATCH_SIZE=2
FORGE_EMBED_THREADS=4
FORGE_EMBED_BATCH_SIZE=8

FORGE_CHUNK_SIZE=1600
FORGE_CHUNK_OVERLAP=280
FORGE_RETRIEVAL_K=8
FORGE_MIN_SIMILARITY=0.32
FORGE_MAX_CONTEXT_CHARS=12000
FORGE_MAX_HISTORY_CHARS=12000
